{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "installCommand": "yarn install",
  "devCommand": "vite",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/auth/session",
      "destination": "/api/auth/login"
    },
    {
      "source": "/((?!api/|assets/)(?!.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
