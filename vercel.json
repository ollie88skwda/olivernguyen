{
  "buildCommand": "react-scripts build",
  "outputDirectory": "build",
  "installCommand": "yarn install",
  "devCommand": "react-scripts start",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api/|static/)(?!.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
