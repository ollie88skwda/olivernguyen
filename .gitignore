node_modules

# Vite build output (Vercel builds it; never committed)
dist/

.env.local
.env*.local
.env*

# yarn is the source of truth (see vercel.json installCommand + packageManager)
package-lock.json

.DS_Store

# Playwright scratch output
test-results/
playwright-report/

# Component-gallery eyeballing shots (e2e/gallery-shots.spec.js). These are
# review artefacts, not visual-regression baselines — those live in
# e2e/*.spec.js-snapshots/ and ARE committed.
e2e/__shots__/

# Agent and tooling scratch output. All of this was untracked and unignored, which is
# how an unscoped `git add -A` once swept ~300 junk files into a commit.
.agents/
.claude/
.lavish/
.playwright-mcp/
.vercel/

# Stale Next.js artifacts. This project is Vite; nothing here reads them.
.next/
next-env.d.ts

# Screenshots and one-off exports dropped at the repo root during UI review.
/*.png
/*.b64
/*.zone
